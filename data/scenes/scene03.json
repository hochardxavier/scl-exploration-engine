{
    "id": "scene03",
    
    "name": "troisième scène",
    
    "background": "assets/scenes/cave003.png",
    
    "objects": [
        {
            "id":"safe01",

            "image": "assets/sprites/safe01.png",
            
            "x": 10,
            "y": 85,
            
            "width": 10,
            "height": 10,
            
            "visible": true,
            
            "actions":[

                {

                    "type":"condition",

                    "condition":{
                        "type":"inventory",
                        "item":"key"
                    },

                    "onSuccess":[

                        {
                            "type":"inventoryAdd",
                            "item":"jewels"
                        },

                        {
                            "type":"popup",
                            "title":"Coffre",
                            "text":"Vous ouvrez le coffre et récupérez les joyaux.",
                            "image":"assets/sprites/jewels01.png",
                            "onClose": [
                              {
                                "type": "returnToHost",
                                "event": "jewelsFound"
                              }
                            ]
                        }

                    ],

                    "onFailure":[
                        {
                            "type":"popup",
                            "title":"Le coffre",
                            "text":"Cette serrure nécessite une clé."
                        }
                    ]

                }

            ]

        }
    ]
}
