{
    "id": "halloween01",
    
    "name": "Cimetière",
    
    "background": "assets/scenes/halloween-2026/cimetiere.png",
    
    "flashlight": {
        "enabled": true,
        "radius": 150,
        "intensity": 0.8
    },
    
    "objects": [
        {
            "id": "stele",
            
            "image": "assets/sprites/halloween-2026/stele.png",
            
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            
            "visible": true,
            
            "actions": [
                {
                    "type": "popup",
                    
                    "title": "La vieille tombe",
                    
                    "image": "assets/sprites/halloween-2026/stele.png",
                    
                    "text": "Cette vieille tombe n'a pas de nom, juste un texte presque effacé par le temps.",
                    
                    "button": "Suivant",
                    
                    "onClose": [
                        {
                            "type": "popup",
                            
                            "title": "La vieille tombe",
                            
                            "image": "assets/sprites/halloween-2026/stele.png",
                            
                            "text": "Brave hussard, à ton retour retrouve la Dame de l'Eau à la Fontaine Saillard.\nElle lèvera la malédiction.\nMais ne sombre pas dans la faim qui te tiraille.",
                            
                            "button": "Fermer"
                        }
                    ]
                }
            ]
        },
        
        {
            "id": "cisaille",
            
            "image": "assets/sprites/halloween-2026/cisaille.png",
            
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            
            "visible": true,
            
            "actions": [
                {
                    "type": "condition",
                    
                    "condition": {
                        "type": "inventory",
                        "item": "citrouille"
                    },
                    
                    "onSuccess": [
                        {
                            "type": "popup",
                            
                            "title": "La citrouille",
                            
                            "image": "assets/sprites/halloween-2026/jack.png",
                            
                            "text": "Vous taillez la citrouille en forme de tête. Avez-vous trouvé une bougie ?",
                            
                            "button": "Fermer",
                            
                            "onClose": [
                                {
                                    "type": "inventoryAdd",
                                    "item": "jack"
                                },
                                {
                                    "type": "inventoryRemove",
                                    "item": "citrouille"
                                }
                            ]
                        }
                    ],
                    
                    "onFailure": [
                        {
                            "type": "popup",
                            
                            "title": "Les cisailles",
                            
                            "image": "assets/sprites/halloween-2026/cisaille.png",
                            
                            "text": "Des cisailles... Elles semblent parfaitement adaptées pour tailler quelque chose. Mais quoi ?",
                            
                            "button": "Fermer"
                        }
                    ]
                }
            ]
        }
    ]
}
